{
  "name": "nundina",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm -r --parallel --if-present dev",
    "db:up": "docker compose up -d postgres",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy:local": "tsx scripts/contracts.ts deploy local",
    "contracts:deploy:testnet": "tsx scripts/contracts.ts deploy testnet",
    "contracts:deploy:mainnet": "tsx scripts/contracts.ts deploy mainnet",
    "contracts:dry-run:mainnet": "tsx scripts/contracts.ts dry-run mainnet",
    "contracts:verify": "tsx scripts/contracts.ts verify testnet",
    "contracts:smoke": "tsx scripts/contracts.ts smoke testnet",
    "contracts:smoke:local": "tsx scripts/contracts.ts smoke local",
    "contracts:export": "tsx scripts/export-abis.ts && tsx scripts/sync-addresses.ts",
    "chain:local": "anvil --chain-id 31337 --block-time 2",
    "contracts:check-roles": "pnpm --filter @nundina/api exec tsx --env-file-if-exists=../../.env scripts/check-roles.ts",
    "contracts:check-roles:local": "pnpm --filter @nundina/api exec tsx --env-file-if-exists=../../.env scripts/check-roles-local.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
