# ───────────── chain ─────────────
# HashKey Chain mainnet RPC (chainId 177)
HSK_RPC_URL=https://mainnet.hsk.xyz
# HashKey Chain testnet RPC (chainId 133, confirmed via eth_chainId)
HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz
HSK_TESTNET_CHAIN_ID=133
# Which chain the services talk to: 177 (mainnet) or 133 (testnet)
CHAIN_ID=177
# Deploys contracts (funded with HSK)
DEPLOYER_PRIVATE_KEY=
# Sponsors provider commits + credits HSP payments (needs RELAYER/CREDITOR roles)
RELAYER_PRIVATE_KEY=
# Sends proveTouch / settle / sweeps
KEEPER_PRIVATE_KEY=
# Blockscout API key for contract verification
BLOCKSCOUT_API_KEY=
# Testnet Blockscout base URL (TODO(confirm); testnet-explorer.hsk.xyz did not resolve on Oct 26)
HSK_TESTNET_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# Local anvil RPC for development (pnpm chain:local)
LOCAL_RPC_URL=http://127.0.0.1:8545
# Public addresses wired at deploy (default: deployer)
RELAYER_ADDRESS=
KEEPER_ADDRESS=
CREDIT_SIGNER_ADDRESS=
TREASURY_ADDRESS=
KYC_ISSUER_ADDRESS=
# Signs escrow Credit/Recover messages after HSP verify() = ACCEPT (API only)
CREDIT_SIGNER_PRIVATE_KEY=
# Must be "yes" for any mainnet deploy/smoke
CONFIRM_MAINNET=

# ───────────── HSP (from organizers) ─────────────
# mock = local MockRail, live = real HSP coordinator
HSP_MODE=mock
HSP_COORDINATOR_URL=
HSP_API_KEY=
HSP_CHAIN=
# Adapter signer address pinned from GET /chains
HSP_ADAPTER_ADDRESS=
HSP_FACILITATOR_URL=
HSP_ISSUER_URL=
# HSP explorer base (default <coordinator>/explorer)
HSP_EXPLORER_URL=
# Mock rail adapter key that signs receipts (default: derived from INTERNAL_SECRET)
MOCK_ADAPTER_PRIVATE_KEY=
# USDC.e EIP-3009 one-transaction purchases
FAST_PATH_ENABLED=false

# ───────────── oracles ─────────────
APRO_BTC_USD=0x204ED500ab56A2E19B051561258E3A45c850360F
APRO_HSK_USD=0x86CE42c1b714149Dc3A7b17169EF67b5F78A224b
SUPRA_PULL=0x16f70cAD28dd621b0072B5A8a8c392970E87C3dD
# Supra REST/gRPC endpoint that returns pull proofs
SUPRA_PROOF_API_URL=

# ───────────── tokens ─────────────
USDT=0xF1B50eD67A9e2CC94Ad3c477779E2d4cBfFf9029
USDC_E=0x054ed45810DbBAb8B27668922D110669c9D88D0a

# ───────────── backend ─────────────
DATABASE_URL=postgres://nundina:nundina@localhost:5432/nundina
# 32 bytes hex (64 chars); encrypts per-signal AES keys at rest
KEY_SERVICE_MASTER_KEY=
# Previous master key while rotating (old rows still decrypt)
KEY_SERVICE_MASTER_KEY_PREVIOUS=
# Shared secret for service-to-service calls (bot/keeper/agents -> api)
INTERNAL_SECRET=
# API server port and its public URL (used in OpenAPI + ERC-8004 agent URIs)
PORT=8787
PUBLIC_API_URL=http://localhost:8787
# Comma-separated origins allowed by CORS (web app + Mini App)
WEB_ORIGIN=http://localhost:3000
# Signs session cookies; defaults to a value derived from INTERNAL_SECRET
SESSION_SECRET=
# Relayer refuses to send below this HSK balance (wei); default 0.05 HSK
RELAYER_MIN_BALANCE_WEI=50000000000000000
# pino level: debug | info | warn | error
LOG_LEVEL=info
# Run pg-boss workers (hsp.verify, signal.reveal) inside the API process
RUN_WORKERS=true
# Claude Haiku for the signal parser fallback + news agent
ANTHROPIC_API_KEY=

# ───────────── telegram ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=        # checked on every webhook call (X-Telegram-Bot-Api-Secret-Token)
BOT_WEBHOOK_URL=                # public HTTPS base for the webhook; empty = long polling (dev)
BOT_PORT=8788
API_URL=http://127.0.0.1:8787   # the bot calls the API with INTERNAL_SECRET
MINI_APP_URL=http://localhost:3000/tg
WEB_URL=http://localhost:3000

# ───────────── web ─────────────
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BOT_USERNAME=
NEXT_PUBLIC_HSP_EXPLORER_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/rohan911438/Nundina
# show the one-transaction USDC.e (EIP-3009) buy button
NEXT_PUBLIC_FAST_PATH_ENABLED=false

# ── Indexer (apps/indexer) ──
INDEXER_CHAIN_ID=133          # 177 mainnet, 133 testnet, 31337 anvil (falls back to CHAIN_ID)
INDEXER_DB_SCHEMA=ponder      # Postgres schema for Ponder's raw tables
INDEXER_PORT=42069            # GraphQL, bound to 127.0.0.1 only
INDEXER_CONFIRMATIONS=1       # blocks behind head before projecting
# INDEXER_START_BLOCK=        # override the deployment block (tests on a fresh anvil use 0)

# --- keeper (apps/keeper) ---
KEEPER_PORT=8790              # /health, bound to 127.0.0.1 only
KEEPER_MIN_BALANCE_HSK=5      # /health goes 503 below this
KEEPER_MAX_GWEI=50            # skip a tx rather than pay more than this
KEEPER_PUSH_INTERVAL_S=120    # local/testnet only: how often the keeper pushes MockPriceAdapter rounds
# SUPRA_PROOF_API_URL=        # mainnet touch proofs; without it signals resolve at expiry

# ── agents (prompt 13). Each strategy/aggregator agent has its own wallet (gas + USDT for bond and buys).
AGENT_MOMENTUM_PRIVATE_KEY=
AGENT_FUNDING_PRIVATE_KEY=
AGENT_SENTIMENT_PRIVATE_KEY=
AGENT_AGGREGATOR_PRIVATE_KEY=
# kill switch for every agent process
AGENTS_DISABLED=false
AGENT_BOND_USD=20
EXECUTION_INTERVAL_S=60
AGGREGATOR_INTERVAL_S=7200

# ── MCP server (prompt 14)
MCP_PORT=8791
MCP_PUBLIC_URL=http://localhost:8791
VERIFY_PRICE_UNITS=10000
MCP_PAY_TO=
MCP_IDENTITY_PRIVATE_KEY=
MCP_ERC8004_AGENT_ID=
# custodial demo mode (testnet/local only)
MCP_CUSTODIAL=false
MCP_DEMO_PRIVATE_KEY=
MCP_DEMO_MAX_PER_SIGNAL_UNITS=500000
MCP_DEMO_DAILY_UNITS=2000000
# stdio mode acts with this key (nk_…)
NUNDINA_API_KEY=

# ── agents market data (defaults shown)
# BINANCE_URL=https://api.binance.com
# BINANCE_FUTURES_URL=https://fapi.binance.com
# NEWS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed,https://bitcoinmagazine.com/.rss/full/
# RUN_ONCE=false   # one tick then exit (demos, cron)

# ── hardening + monitoring (prompt 15, API)
# requests/minute per user or IP; auth endpoints get a tenth; 0 disables
RATE_LIMIT_PER_MIN=300
# /status + Telegram alerts every 5 min: keeper balance (KEEPER_ADDRESS above), other services, team chat
KEEPER_MIN_BALANCE_WEI=50000000000000000
STATUS_SERVICES=bot=http://localhost:8788/health,keeper=http://127.0.0.1:8790/health,mcp=http://localhost:8791/health
ALERT_TELEGRAM_CHAT_ID=
# tests (pnpm test) create and drop this database
TEST_DATABASE_URL=postgres://nundina:nundina@localhost:5432/nundina_test
